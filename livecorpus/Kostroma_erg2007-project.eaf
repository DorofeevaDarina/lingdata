    <TIER ANNOTATOR="@ddd2007f" LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@erg2007m" PARTICIPANT="@erg2007m" TIER_ID="gestComment@erg2007m">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409"
                TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>начала эде совпадают с каждым новым жестовым "витком" (новым движением пальцев и кистей)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410"
                TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>можно сказать, что жест прагматический -- новое движение кисти и пальцев акцентирует внимание на начале новой эде; а можно сказать, что жест указательный -- говорящий указывает на определённое время в прошлом</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411"
                TIME_SLOT_REF1="ts121" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE/>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412"
                TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>да, еле заметно, но он чуть поворачивать кисть с началом новой эде!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413"
                TIME_SLOT_REF1="ts299" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>не только к этой аннотации: я думаю, что весь последний фрагмент, где Егор сидит с переплетённым пальцами -- адаптор, но в некоторых кусках, которые я выделела, прослеживаются смысловые акценты, сделанные руками</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER ANNOTATOR="@ddd2007f" LINGUISTIC_TYPE_REF="utterance"
        PARTICIPANT="@ddd2007f" TIER_ID="text@ddd2007f">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts2">
                <ANNOTATION_VALUE>ты веришь в бога?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423"
                TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>ммм</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424"
                TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>а ты можешь подробнее рассказать пожалуйста?</ANNOTATION_VALUE>
